# Telegram Bot Token (получите у @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenRouter API Key (https://openrouter.ai/keys — начинается с sk-or-v1-).
# Провайдер по умолчанию: на нём работает Muse Spark 1.3 Contributor.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Тариф contributor требует один раз разрешить обучение на ваших промптах в
# https://openrouter.ai/settings/privacy и подтвердить 18+ в
# https://openrouter.ai/settings/preferences. Без этого эндпоинт отвечает 404
# и 403 соответственно. Не хотите отдавать промпты — выберите в /menu модель
# muse-spark-full, она тех же настроек не требует, но дороже в 12-20 раз.

# Глубина размышлений Muse Spark: minimal | low | medium | high | xhigh.
# Размышления идут в reasoning и в чат не попадают, поэтому их глубина — это
# время молчания бота. minimal даёт полный ответ за 2-3с, xhigh за 8-16с.
# OPENROUTER_REASONING_EFFORT=minimal

# NVIDIA API Key (получите на https://build.nvidia.com/ — начинается с nvapi-).
# Нужен, только если переключаетесь на провайдера NVIDIA в /menu.
NVIDIA_API_KEY=your_nvidia_api_key_here

# Tavily API Key для веб-поиска (https://tavily.com, начинается с tvly-).
# Необязателен: без него бот просто отвечает по памяти модели, без поиска.
TAVILY_API_KEY=your_tavily_api_key_here

# Куда класть progress.json (настройки и прогресс пользователей).
# На Railway контейнер эфемерный: без примонтированного тома файл стирается
# при каждом деплое. Смонтируйте том в /data и раскомментируйте:
# DATA_DIR=/data

# Необязательно: переопределить эндпоинт (например, если ходите через свой прокси)
# NVIDIA_API_BASE=https://integrate.api.nvidia.com/v1
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Премиальные <tg-emoji> доступны только ботам с доп. именем, купленным на
# Fragment. Если Telegram отвергает разметку — выключите их: CUSTOM_EMOJI=0
# CUSTOM_EMOJI=0

# Потолки времени, секунды. Ответ или честная ошибка приходят гарантированно.
# TOTAL_DEADLINE   — на все попытки одного запроса к модели (повторы + запасные)
# STREAM_TIMEOUT   — молчание МЕЖДУ порциями потока, а не на весь ответ
# ROUTE_TIMEOUT    — вызов «нужен ли поиск»
# RESEARCH_BUDGET  — весь цикл поиска целиком
# CONNECT_TIMEOUT  — установка соединения; она обязана быть быстрой
# TOTAL_DEADLINE=120
# STREAM_TIMEOUT=60
# ROUTE_TIMEOUT=30
# RESEARCH_BUDGET=150
# CONNECT_TIMEOUT=5
